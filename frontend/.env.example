# Copy to .env.production when building for production.
# Only needed if the backend runs on a different URL than the frontend.
# If backend and frontend are on the same server (Nginx proxies /api), leave this empty or omit.

# Backend URL (no trailing slash). Example:
# VITE_API_BASE=https://api.yourproject.com

# Same server: leave empty
# VITE_API_BASE=
