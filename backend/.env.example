# Copy to .env and set your values. The backend reads these when running.
# Do not commit .env (it is in .gitignore).

YOUTUBE_API_KEY="AIzaSyBwL6D5aa5SUCDoe_SBdnE9R8JGp0Jt8P4"

# Optional: password researchers must enter to "Store this video" (default in code if unset)
# STORE_PASSWORD=SBRH8888

# Optional: password required to delete stored videos (default SBRH6666)
# DELETE_PASSWORD=SBRH6666

# Optional: comment cache size (default 200)
# VCM_COMMENT_CACHE_SIZE=200

# Optional: CORS allowed origins (comma-separated). Unset = allow all (*). For production set your frontend URL, e.g.:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: rate limits per IP (defaults: 20/min analyze, 30/min store, 60/min other)
# RATE_LIMIT_ANALYZE=20/minute
# RATE_LIMIT_STORE=30/minute
# RATE_LIMIT_GENERAL=60/minute
